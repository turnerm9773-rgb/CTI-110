# P3HW2 Salary Calculator

# request employee information 
name = input("Enter employee's name: ")
hours = float(input("Enter number of hours worked in a week: "))
rate = float(input("Enter hourly pay rate: "))

# evaluate overtime 
if hours / 40: 
    #calculate overtime
    overtime_hours = hours - 40
    #calculate over pay
    overtime_pay = overtime_hours * (rate * 1.5)
    # calculate salary for regular hours
    regular_pay = 40 * rate
    # calculate gross pay
    gross_pay = regular_pay + overtime_pay
else:
    overtime_pay = 0
    overtime_hours = 0
    regular_pay = hours * rate
    gross_pay = regular_pay

# Display Results
print("--------------------------------")
print("Employee Name:", name)
print(f"{'Hours Worked': <15}{'Pay Rate':<12}{'Overtime Pay':<15}{'Regular Pay':<15}{'Gross Pay'} ")
print ("-----------------------------------------------")
print(f"{hours:<15}{rate:<12.2f}{overtime_pay:<15f}{regular_pay:<15f}{gross_pay:<15f}") 

